# Speech Arena backend settings. Copy this file to .env (gitignored) and fill in values.
# The API refuses to start if a required key is missing. Never commit .env.

# MongoDB: accounts, consent records, security audit log.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=speech_arena

# Redis (or Memurai on Windows): sign-in sessions and leaderboards. Required: nobody can sign in without it.
REDIS_URL=redis://127.0.0.1:6379/0

# Web origins allowed to call the API with the session cookie (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1 when the site is served over HTTPS (session cookie gets the Secure flag).
COOKIE_SECURE=0

# Where `python backend/api/main.py` listens. 127.0.0.1 = this machine only.
API_HOST=127.0.0.1
API_PORT=8000

# 1 enables /docs (loads scripts from a third-party CDN; local development only).
ENABLE_DOCS=0

# Contact link shown in the legal pages and the privacy API.
PRIVACY_CONTACT_URL=https://github.com/Anwesha-Mondal/ml-speech/issues

# Stops Hugging Face libraries from sending usage telemetry.
HF_HUB_DISABLE_TELEMETRY=1
