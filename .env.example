# Speech Arena backend settings. Copy this file to .env (gitignored) and fill in values.
# The API refuses to start if a required key is missing. Never commit .env.

# MongoDB: accounts, sign-in sessions, consent records, security audit log, leaderboards.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=speech_arena

# Web origins allowed to call the API with the session cookie (comma-separated).
# In production with Vercel, include your Vercel deployment URL: https://<your-project>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Regex pattern for origins (e.g. allows all Vercel preview branches automatically)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# 1 when the site is served over HTTPS (session cookie gets the Secure flag).
# Required in production on Render/Vercel: set to 1.
COOKIE_SECURE=0

# Cookie SameSite: 'none' is REQUIRED when frontend (Vercel) and backend (Render)
# live on different domains so browsers attach cross-origin session cookies.
# Default is 'strict' for local development. Set to 'none' in production.
COOKIE_SAMESITE=lax

# Where `python backend/api/main.py` listens. 127.0.0.1 = this machine only.
API_HOST=127.0.0.1
API_PORT=8000

# 1 enables /docs (loads scripts from a third-party CDN; local development only).
ENABLE_DOCS=0

# Address of the web app, used in password reset links.
APP_URL=http://localhost:5173

# How password reset links reach users: none (default; admins use `python -m backend.auth.cli reset-link`)
# or log (local development only: the link is printed in the API console). Never returned by the API.
PASSWORD_RESET_DELIVERY=none

# Contact link shown in the legal pages and the privacy API.
PRIVACY_CONTACT_URL=https://github.com/pushkarverse/orcter/issues

# Stops Hugging Face libraries from sending usage telemetry.
HF_HUB_DISABLE_TELEMETRY=1
